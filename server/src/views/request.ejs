<!doctype html>
<html lang="ko">
<head><%- include("partials/head") %></head>
<body>
<nav><a href="/">인물 목록</a><a href="/requests">수정 요청</a><a href="/authors">작성자</a><a href="/about">소개</a></nav>
<h1>수정 요청 #<%= request.id %></h1>
<dl>
  <dt>인물</dt><dd><a href="/persons/<%= request.person_slug %>"><%= person ? person.name : request.person_slug %></a></dd>
  <dt>대상 필드</dt><dd><%= request.field %></dd>
  <dt>요청자</dt><dd><%= request.requester_name %> (<%= request.requester_contact %>)</dd>
  <dt>제안 내용</dt><dd><%= request.proposed %></dd>
  <dt>근거 출처</dt><dd><%= request.evidence %></dd>
  <dt>요청 시각</dt><dd><%= request.created_at %></dd>
  <dt>상태</dt><dd><span class="badge <%= request.status === "accepted" ? "ok" : "warn" %>"><%= request.status %></span></dd>
  <% if (request.status === "accepted" || request.status === "rejected") { %>
  <dt>처리자</dt><dd><%= request.resolver_name %> · <%= request.resolved_at %></dd>
  <dt>처리 사유</dt><dd><%= request.resolution_note %></dd>
  <% if (request.resolved_version_id) { %>
  <dt>반영 버전</dt><dd><a href="/versions/<%= request.resolved_version_id %>/diff">#<%= request.resolved_version_id %> 변경 내역</a></dd>
  <% } %>
  <% } %>
</dl>

<% if (request.status === "open") { %>
<h2>심사 전환</h2>
<p>사실관계가 다툴 여지가 있는 실질 변경은 심사로 올려 복수 검토자의 공개 리뷰를 받습니다.</p>
<form method="post" action="/requests/<%= request.id %>/escalate">
  <button type="submit">심사로 전환</button>
</form>
<% } %>

<% if (reviews.length) { %>
<h2>심사 기록 (공개)</h2>
<p>정족수 현황: 승인 <%= quorum.approvals %>/2 · 반대 <%= quorum.rejects %>
   <% if (quorum.passed) { %><span class="badge ok">정족수 충족</span><% } %></p>
<table>
  <thead><tr><th>검토자</th><th>평결</th><th>의견</th><th>시각</th></tr></thead>
  <tbody>
  <% for (const rv of reviews) { %>
  <tr>
    <td><%= rv.reviewer_name %></td>
    <td><span class="badge <%= rv.verdict === "approve" ? "ok" : "warn" %>"><%= rv.verdict %></span></td>
    <td><%= rv.comment %></td>
    <td><%= rv.created_at %></td>
  </tr>
  <% } %>
  </tbody>
</table>
<% } %>

<% if (request.status === "in_review") { %>
<h2>리뷰 작성 (실명 공개)</h2>
<p>제안자 본인의 리뷰는 정족수에서 제외됩니다. 같은 검토자가 다시 남기면 최신 평결만 유효합니다.</p>
<form method="post" action="/requests/<%= request.id %>/reviews">
  <p><label>검토자 이름(실명) <input name="reviewerName" required></label></p>
  <p><label>평결
    <select name="verdict">
      <option value="approve">승인</option>
      <option value="reject">반려</option>
      <option value="needs_work">보완 요청</option>
    </select></label></p>
  <p><label>의견(근거 종합)<br>
     <textarea name="comment" rows="4" cols="60" required></textarea></label></p>
  <button type="submit">리뷰 남기기</button>
</form>
<% } %>

<% if (request.status === "open" || request.status === "in_review") { %>
<h2>처리 (작성자 전용)</h2>
<% if (request.status === "open") { %>
<p>단순 정정(오탈자·명백한 오기)은 심사 없이 여기서 단독 처리합니다.</p>
<% } else if (!quorum.passed) { %>
<p>정족수(승인 2 이상·반대 0)를 채우기 전에는 수용할 수 없습니다. 반려는 가능합니다.</p>
<% } %>
<form method="post" action="/requests/<%= request.id %>/resolve">
  <p><label>처리 상태
    <select name="status">
      <% if (request.status === "open" || quorum.passed) { %>
      <option value="accepted">수용</option>
      <% } %>
      <option value="rejected">반려</option>
    </select></label></p>
  <p><label>처리자 이름(실명) <input name="resolverName" required></label></p>
  <p><label>반영 버전 id (수용 시) <input name="versionId"></label></p>
  <p><label>사유 (반려 시 필수)<br>
     <textarea name="note" rows="4" cols="60"></textarea></label></p>
  <button type="submit">처리 기록 남기기</button>
</form>
<% } %>
</body>
</html>
