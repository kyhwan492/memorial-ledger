<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>기억 원장</title>
<script src="/vendor/htmx.min.js"></script>
<style>
  :root {
    --ink: #23241f;        /* 본문 먹색 */
    --ink-soft: #6b6a63;   /* 보조 텍스트 */
    --paper: #faf8f4;      /* 배경 — 오래된 종이 톤 */
    --surface: #ffffff;
    --line: #e3dfd6;
    --accent: #8b2e2a;     /* 인장 붉은색 — 핵심 행동 전용 */
    --accent-ink: #fff;
    --link: #21518f;
    --ok-bg: #e8f2e9; --ok-ink: #23551f;
    --warn-bg: #fbeee7; --warn-ink: #8a3b12;
  }
  * { box-sizing: border-box; }
  body {
    font-family: "Pretendard Variable", Pretendard, "Apple SD Gothic Neo", "Noto Sans KR",
      "Malgun Gothic", sans-serif;
    color: var(--ink); background: var(--paper);
    max-width: 60rem; margin: 0 auto; padding: 0 1.25rem 4rem;
    line-height: 1.65; font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }
  h1 { font-size: 1.9rem; line-height: 1.25; letter-spacing: -.01em; margin: 1.2rem 0 .4rem; }
  h2 { font-size: 1.15rem; line-height: 1.3; margin: 2.2rem 0 .7rem; padding-bottom: .35rem;
       border-bottom: 1px solid var(--line); }
  a { color: var(--link); }
  a:visited { color: #5c4a8f; }
  small, .muted { color: var(--ink-soft); }

  nav {
    display: flex; flex-wrap: wrap; gap: 1.1rem; align-items: baseline;
    padding: .9rem 0; margin-bottom: .5rem; border-bottom: 1px solid var(--line);
  }
  nav .brand { font-weight: 700; color: var(--ink); text-decoration: none; margin-right: .4rem; }
  nav a { color: var(--ink-soft); text-decoration: none; }
  nav a:hover { color: var(--ink); text-decoration: underline; }
  nav a:visited { color: var(--ink-soft); }

  table { border-collapse: collapse; width: 100%; background: var(--surface);
          border: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  td, th { border-bottom: 1px solid var(--line); padding: .55rem .7rem; text-align: left; }
  th { font-size: .8rem; color: var(--ink-soft); font-weight: 600; background: var(--paper); }
  tbody tr:hover { background: #f5f1e9; }
  tbody tr:last-child td { border-bottom: none; }
  td.empty, .pager td { text-align: center; color: var(--ink-soft); }
  .pager td { display: flex; justify-content: center; gap: 1.2rem; border-bottom: none; }

  button {
    font: inherit; font-size: .92rem; padding: .45rem 1rem; cursor: pointer;
    border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink);
  }
  button:hover { border-color: var(--ink-soft); }
  button:disabled { opacity: .5; cursor: not-allowed; }
  #verify-btn, #donate-btn, #anchor-btn, button[type="submit"] {
    background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600;
  }
  #verify-btn:hover, #donate-btn:hover, #anchor-btn:hover, button[type="submit"]:hover {
    background: #74241f;
  }
  button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--link); outline-offset: 2px;
  }

  input, select, textarea {
    font: inherit; padding: .45rem .6rem; border: 1px solid var(--line);
    border-radius: 6px; background: var(--surface); color: var(--ink); max-width: 100%;
  }
  form { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 1rem 0; }
  form p { flex-basis: 100%; margin: .3rem 0; }

  dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1.2rem; margin: .8rem 0; }
  dt { color: var(--ink-soft); font-size: .88rem; }
  dd { margin: 0; }

  .badge { padding: .15rem .55rem; border-radius: 99px; font-size: .8rem; font-weight: 600; }
  .ok { background: var(--ok-bg); color: var(--ok-ink); }
  .warn { background: var(--warn-bg); color: var(--warn-ink); }

  .monthly {
    background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
    padding: 1rem 1.2rem; margin: 1.2rem 0;
  }
  .monthly .label { font-size: .78rem; font-weight: 700; letter-spacing: .06em;
    color: var(--accent); margin: 0 0 .3rem; }
  .monthly h2, .monthly p { border: none; margin: .1rem 0; padding: 0; }
  .monthly .name { font-size: 1.15rem; font-weight: 700; }

  code { background: #f1ede4; padding: .1rem .35rem; border-radius: 4px;
         font-size: .85em; word-break: break-all; }
  ul { padding-left: 1.2rem; }
</style>
